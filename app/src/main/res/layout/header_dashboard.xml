<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <!-- ── Selector de período ────────────────────────────────────────────── -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_period"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Semana"
            style="@style/Widget.MaterialComponents.Chip.Choice" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mes"
            android:checked="true"
            style="@style/Widget.MaterialComponents.Chip.Choice" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Año"
            style="@style/Widget.MaterialComponents.Chip.Choice" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Todo"
            style="@style/Widget.MaterialComponents.Chip.Choice" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_custom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗓 Personalizar"
            style="@style/Widget.MaterialComponents.Chip.Choice" />

    </com.google.android.material.chip.ChipGroup>

    <!-- ── Rango de fechas activo ─────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tv_active_date_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="4dp"
        android:layout_marginBottom="10dp"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        tools:text="📅 01/02/2025 00:00:00 – 01/03/2025 23:59:59" />

    <!-- ── Tarjetas de resumen ────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/income_bg">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ingresos" android:textSize="11sp" android:textColor="@color/income_label"
                    android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/tv_income" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0,00 €"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="@color/income_amount"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/expense_bg">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Gastos" android:textSize="11sp" android:textColor="@color/expense_label"
                    android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/tv_expenses" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0,00 €"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="@color/expense_amount"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/balance_bg">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Balance" android:textSize="11sp" android:textColor="@color/balance_label"
                    android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/tv_balance" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0,00 €"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="@color/balance_amount"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- ── Gráfico de tarta ───────────────────────────────────────────────── -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Título + botón Estadísticas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gastos por categoría"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <Button
                    android:id="@+id/btn_pie_format_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textSize="13sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    style="@style/Widget.Material3.Button.TextButton" />
                <Button
                    android:id="@+id/btn_manage_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estadísticas"
                    android:textSize="12sp"
                    style="@style/Widget.Material3.Button.TextButton" />
            </LinearLayout>

            <!-- Chips modo pie -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="4dp">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_pie_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_pie_parents"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Padres"
                        android:checked="true"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_pie_children"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subcategorías"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_pie_breakdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Desglosar ▼"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Fila de chips de padres (visible solo en modo Desglosar) -->
            <HorizontalScrollView
                android:id="@+id/scroll_pie_parents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone"
                android:layout_marginBottom="4dp">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_pie_parents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true" />
            </HorizontalScrollView>

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pie_chart"
                android:layout_width="match_parent"
                android:layout_height="230dp" />

            <!-- Tooltip de slice seleccionado — visible al tocar un slice -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_pie_tooltip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/view_tooltip_color"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="10dp"
                        android:background="@color/text_hint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_tooltip_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:maxLines="1"
                            android:ellipsize="end" />
                        <TextView
                            android:id="@+id/tv_tooltip_net"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/expense_amount"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">
                        <TextView
                            android:id="@+id/tv_tooltip_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tv_tooltip_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView android:id="@+id/tv_pie_empty" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin gasto neto en este período"
                android:textSize="13sp" android:textColor="@color/text_hint" android:gravity="center"
                android:visibility="gone" android:paddingTop="30dp" android:paddingBottom="30dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ── Encabezado sección movimientos ────────────────────────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Movimientos"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="10dp" />

    <!-- Barra de búsqueda -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="Buscar movimientos..."
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:endIconMode="clear_text"
        app:boxCornerRadiusTopStart="10dp"
        app:boxCornerRadiusTopEnd="10dp"
        app:boxCornerRadiusBottomStart="10dp"
        app:boxCornerRadiusBottomEnd="10dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Filtro por categoría -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="6dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true" />

    </HorizontalScrollView>

    <!-- Estado vacío: visible cuando no hay movimientos con los filtros aplicados -->
    <TextView
        android:id="@+id/tv_empty_transactions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hay movimientos con los filtros aplicados."
        android:textSize="14sp"
        android:textColor="@color/text_hint"
        android:gravity="center"
        android:visibility="gone"
        android:paddingTop="28dp"
        android:paddingBottom="28dp" />

</LinearLayout>
