<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Texto a excluir">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_exception_pattern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tipo de coincidencia:"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp" />

    <RadioGroup
        android:id="@+id/rg_exception_match_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rb_exc_contains"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contiene — el título incluye este texto"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rb_exc_exact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exacto — el título es exactamente este texto" />

        <RadioButton
            android:id="@+id/rb_exc_regex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expresión regular" />

    </RadioGroup>

</LinearLayout>
