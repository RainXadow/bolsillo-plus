<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <!-- Fecha + concepto -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_skipped_concept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_concept"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_skipped_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_date"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Importe -->
    <TextView
        android:id="@+id/tv_skipped_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginEnd="8dp" />

    <!-- Botón restaurar -->
    <ImageButton
        android:id="@+id/btn_restore_skipped"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_add"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Restaurar movimiento" />

</LinearLayout>
