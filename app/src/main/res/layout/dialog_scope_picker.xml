<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <!-- Opciones fijas de alcance -->
        <RadioGroup
            android:id="@+id/rg_scope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_only_this"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Solo este movimiento"
                android:paddingVertical="10dp" />

            <!-- Texto dinámico: se pone en código "Mismo nombre: '...'" -->
            <RadioButton
                android:id="@+id/rb_exact_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp" />

            <RadioButton
                android:id="@+id/rb_custom_rule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crear regla personalizada..."
                android:paddingVertical="10dp" />

        </RadioGroup>

        <!-- Sección de regla personalizada (GONE por defecto) -->
        <LinearLayout
            android:id="@+id/ll_custom_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Patrón a buscar"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_scope_pattern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <RadioGroup
                android:id="@+id/rg_scope_match_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_scope_contains"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contiene frase (cualquier parte del concepto)"
                    android:checked="true"
                    android:paddingVertical="6dp" />

                <RadioButton
                    android:id="@+id/rb_scope_contains_word"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contiene palabra completa"
                    android:paddingVertical="6dp" />

            </RadioGroup>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
